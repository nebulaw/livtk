#!/usr/bin/env bash
# Everything a change must pass, fastest first, each step timed:
#   scripts/check   format, lint, supply chain, every test (debug), benchmarks and model tests
#
# The CLI's benchmarks time the binary that gets installed, start-up included, so they run in
# release; the core's run in the `quick` profile: release speed, no LTO, rebuilt in seconds.
# The old app (legacy/livtk-app) is kept for reading only: nothing here builds or tests it.
set -euo pipefail
cd "$(dirname "$0")/.."
# Run inside a livtk run, the run's session and task are in the environment: the tests are no
# run, so they never see them (a CLI test reads its session from LIVTK_SESSION).
unset LIVTK_SESSION LIVTK_TASK

step() {
  local label=$1 start=$SECONDS
  shift
  if "$@" >/tmp/livtk-check.$$ 2>&1; then
    printf '%-44s %4ds\n' "$label" $((SECONDS - start))
  else
    printf '%-44s FAILED\n' "$label"
    cat /tmp/livtk-check.$$
    rm -f /tmp/livtk-check.$$
    exit 1
  fi
}
trap 'rm -f /tmp/livtk-check.$$' EXIT

models=${LIVTK_TEST_MODELS:-$HOME/.cache/livtk/models}
step "format" cargo fmt --check
step "lint" cargo clippy -q --workspace --all-targets -- -D warnings
# What livtk may depend on (deny.toml): licences, advisories, sources. The advisory database is
# fetched first (about a second); without a network the cached copy is used.
if ! cargo deny --version >/dev/null 2>&1; then
  echo "(cargo-deny is not installed: cargo install --locked cargo-deny; the supply chain is not checked)"
else
  if ! cargo deny fetch db >/dev/null 2>&1; then
    echo "(cannot fetch the advisory database: checking against the cached copy)"
  fi
  step "supply chain (cargo deny)" cargo deny --offline check
fi
step "tests: core, CLI and updater" cargo test -q
step "tests: Liv and livtk-ui" cargo test -q -p liv -p livtk-ui
if [ -d "$models/potion-retrieval-32M" ]; then
  with_models=(env LIVTK_TEST_MODELS="$models")
  skip=()
else
  echo "(no model in $models: the model tests are skipped)"
  with_models=()
  skip=(--skip with_model)
fi
step "benchmarks and model tests: core" \
  "${with_models[@]}" cargo test -q --profile quick -p livtk-core -- --ignored "${skip[@]}"
step "benchmarks and model tests: CLI (release)" \
  "${with_models[@]}" cargo test -q --release -p livtk-cli -- --ignored "${skip[@]}"
